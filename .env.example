HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
NODE_ENV=development
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=shanhe
MYSQL_USER=shanhe
MYSQL_PASSWORD=replace-with-a-database-password
MYSQL_SSL=false
MYSQL_CONNECTION_LIMIT=5
MYSQL_AUTO_INIT=true
# MYSQL_SSL_CA=/absolute/path/to/mysql-ca.pem

# 账号管理接口（可选）：两项都配置后才启用 /api/account/admin/*
ADMIN_PASSWORD_HASH=
ADMIN_TOKEN_SECRET=
ADMIN_NAME=admin
