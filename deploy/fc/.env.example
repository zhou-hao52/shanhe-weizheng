HOST=0.0.0.0
PORT=9000
NODE_ENV=production
PUBLIC_ORIGIN=https://your-domain.example
MYSQL_HOST=your-rds-private-endpoint.example
MYSQL_PORT=3306
MYSQL_DATABASE=shanhe
MYSQL_USER=shanhe_app
MYSQL_PASSWORD=replace-in-fc-console-only
MYSQL_CONNECTION_LIMIT=2
MYSQL_AUTO_INIT=false
MYSQL_SSL=true
# MYSQL_SSL_CA=/run/secrets/mysql-ca.pem

# 账号管理接口（可选）：两项都配置后才启用 /api/account/admin/*
# 口令哈希用 server/security.mjs 的 hashPassword 生成，格式 scrypt$N$r$p$salt$key
ADMIN_PASSWORD_HASH=
# 32 字节以上的随机串，用于给管理令牌签名；更换后所有已签发的管理令牌立即失效
ADMIN_TOKEN_SECRET=
